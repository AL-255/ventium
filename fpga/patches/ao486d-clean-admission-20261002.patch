+static int preflight_input(const char *name, off_t exact_size, bool writable, struct stat *observed) {
+    struct stat before, opened, after;
+    if (lstat(name, &before) || !S_ISREG(before.st_mode) || before.st_nlink != 1 ||
+        (exact_size ? before.st_size != exact_size : (before.st_size <= 0 || before.st_size % 512))) {
+        fprintf(stderr, "clean preflight: invalid regular single-link %s: %s\n",
+                exact_size ? "ROM" : "512-byte-sector media", name);
+        return 0;
+    }
+    int fd = open(name, (writable ? O_RDWR : O_RDONLY) | O_NOFOLLOW | O_CLOEXEC);
+    if (fd < 0) {
+        fprintf(stderr, "clean preflight: open %s: %s\n", name, strerror(errno));
+        return 0;
+    }
+    bool valid = !fstat(fd, &opened) && !lstat(name, &after) &&
+                 same_input_stat(before, opened) && same_input_stat(opened, after);
+    close(fd);
+    if (!valid) {
+        fprintf(stderr, "clean preflight: input identity changed: %s\n", name);
+        return 0;
+    }
+    if (observed) *observed = opened;
+    return 1;
