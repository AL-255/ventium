+static bool parse_clean_unsigned(const char *text, int base, unsigned long long maximum,
+                                 unsigned long long *value) {
+    // Reject signs/leading space. Decimal options must consist only of digits;
+    // base-0 address syntax is accepted only when strtoull consumes all input.
+    if (!text || text[0] < '0' || text[0] > '9') return false;
+    if (base == 10)
+        for (const char *p = text; *p; p++) if (*p < '0' || *p > '9') return false;
+    errno = 0;
+    char *end = nullptr;
+    unsigned long long parsed = strtoull(text, &end, base);
+    if (errno == ERANGE || end == text || *end || parsed > maximum) return false;
+    *value = parsed;
+    return true;
+}
 
