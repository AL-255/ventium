+static int require_safe_ddr_iomem() {
+    FILE *map = fopen("/proc/iomem", "rb");
+    if (!map) { fprintf(stderr, "clean DDR guard: cannot read /proc/iomem\n"); return 0; }
+    const unsigned long long first = DDR_BASE_DEFAULT;
+    const unsigned long long last = first + DDR_SIZE - 1;
+    bool valid = true, system_ram_seen = false;
+    char line[512];
+    while (fgets(line, sizeof(line), map)) {
+        size_t length = strlen(line);
+        if (length == sizeof(line) - 1 && line[length - 1] != '\n') { valid = false; break; }
+        char *p = line, *end;
+        while (*p == ' ' || *p == '\t') p++;
+        if (!isxdigit((unsigned char)*p)) { valid = false; break; }
+        errno = 0; unsigned long long low = strtoull(p, &end, 16);
+        if (errno || end == p || *end != '-') { valid = false; break; }
+        p = end + 1;
+        if (!isxdigit((unsigned char)*p)) { valid = false; break; }
+        errno = 0; unsigned long long high = strtoull(p, &end, 16);
+        if (errno || end == p || low > high) { valid = false; break; }
+        p = end; while (*p == ' ' || *p == '\t') p++;
+        if (*p++ != ':') { valid = false; break; }
+        while (*p == ' ' || *p == '\t') p++;
+        end = p + strlen(p);
+        while (end > p && isspace((unsigned char)end[-1])) *--end = 0;
+        if (!*p) { valid = false; break; }
+        if (!strcmp(p, "System RAM")) {
+            if (low == high) { valid = false; break; } // even partially masked maps are unsafe evidence
+            system_ram_seen = true;
+            if (low <= last && high >= first) {
+                fprintf(stderr, "clean DDR guard: System RAM %llx-%llx overlaps aperture %llx-%llx\n",
+                        low, high, first, last);
+                valid = false; break;
+            }
+        }
+    }
+    if (ferror(map)) valid = false;
+    fclose(map);
+    if (!valid || !system_ram_seen) {
+        fprintf(stderr, "clean DDR guard: missing/malformed/masked or overlapping memory map; refusing /dev/mem\n");
+        return 0;
+    }
+    return 1;
+}
