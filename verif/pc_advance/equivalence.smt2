; Full-domain arithmetic proof. run_gate.py binds this model to the normalized
; production expression before claiming a proof; update both after an edit.
(set-logic QF_BV)
(set-option :timeout 10000)
(declare-fun pc () (_ BitVec 32))
(declare-fun u () (_ BitVec 4))
(declare-fun v () (_ BitVec 4))
(declare-fun paired () Bool)
(declare-fun code16 () Bool)
(define-fun wrap ((a (_ BitVec 32))) (_ BitVec 32)
  (ite code16 ((_ zero_extend 16) ((_ extract 15 0) a)) a))
(define-fun old_u () (_ BitVec 32) (wrap (bvadd pc ((_ zero_extend 28) u))))
(define-fun old_post () (_ BitVec 32)
  (wrap (bvadd pc ((_ zero_extend 28) u) (ite paired ((_ zero_extend 28) v) #x00000000))))
(define-fun sum5 () (_ BitVec 5) (bvadd ((_ zero_extend 1) u) ((_ zero_extend 1) v)))
(define-fun new_u () (_ BitVec 32) (wrap (bvadd pc ((_ zero_extend 28) u))))
(define-fun new_uv () (_ BitVec 32) (wrap (bvadd pc ((_ zero_extend 27) sum5))))
(define-fun new_post () (_ BitVec 32) (ite paired new_uv new_u))
(check-sat)
(push)
(assert (or (not (= old_u new_u)) (not (= old_post new_post))))
(check-sat)
(pop)
(push)
(assert (and (= pc #x00014562) (= u #x3) (= v #x2) paired (not code16)))
(check-sat)
(assert (not (= new_post #x00014567)))
(check-sat)
(pop)
