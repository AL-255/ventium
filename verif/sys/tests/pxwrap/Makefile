# pxwrap — build the bare-metal wrapped cross-privilege frame-probe
# regression image.  The case table is generated by gen_cases.py (the
# frm_slot_off slot plan + QEMU push-order/CR2 semantics).  Same toolchain
# and image layout as pxprobe: gcc -m32 + GNU ld + objcopy, a flat 64 KiB
# -bios image.
CC      ?= gcc
OBJCOPY ?= objcopy
CFLAGS  := -m32 -ffreestanding -nostdlib -fno-pic -fno-pie -Wall

IMG_BYTES := 65536      # exactly 64 KiB (a -bios image's reset vector is F000:FFF0)

all: pxwrap.bin

pxwrap_cases.inc: gen_cases.py
	python3 gen_cases.py

pxwrap.o: pxwrap.S pxwrap_cases.inc
	$(CC) $(CFLAGS) -c $< -o $@

pxwrap.elf: pxwrap.o pxwrap.ld
	$(CC) $(CFLAGS) -static -no-pie -nostdlib -Wl,-T,pxwrap.ld -Wl,--build-id=none \
	    pxwrap.o -o pxwrap.elf

pxwrap.bin: pxwrap.elf
	$(OBJCOPY) -O binary pxwrap.elf pxwrap.bin
	@truncate -s $(IMG_BYTES) pxwrap.bin
	@echo "pxwrap.bin: $$(stat -c%s pxwrap.bin) bytes (want $(IMG_BYTES))"

clean:
	rm -f pxwrap.o pxwrap.elf pxwrap.bin pxwrap_cases.inc

.PHONY: all clean
