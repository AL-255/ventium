# pxwrapm — build the bare-metal wrapped frame-probe ZERO-BYTES witness
# image.  The case table is generated by gen_cases.py in ../pxwrap (the
# frm_slot_off slot plan + QEMU push-order/partial-write semantics).
# Same toolchain and image layout as pxprobe: gcc -m32 + GNU ld + objcopy,
# a flat 64 KiB -bios image.
CC      ?= gcc
OBJCOPY ?= objcopy
CFLAGS  := -m32 -ffreestanding -nostdlib -fno-pic -fno-pie -Wall

IMG_BYTES := 65536      # exactly 64 KiB (a -bios image's reset vector is F000:FFF0)

all: pxwrapm.bin

pxwrapm_cases.inc: ../pxwrap/gen_cases.py
	python3 ../pxwrap/gen_cases.py

pxwrapm.o: pxwrapm.S pxwrapm_cases.inc
	$(CC) $(CFLAGS) -c $< -o $@

pxwrapm.elf: pxwrapm.o pxwrapm.ld
	$(CC) $(CFLAGS) -static -no-pie -nostdlib -Wl,-T,pxwrapm.ld -Wl,--build-id=none \
	    pxwrapm.o -o pxwrapm.elf

pxwrapm.bin: pxwrapm.elf
	$(OBJCOPY) -O binary pxwrapm.elf pxwrapm.bin
	@truncate -s $(IMG_BYTES) pxwrapm.bin
	@echo "pxwrapm.bin: $$(stat -c%s pxwrapm.bin) bytes (want $(IMG_BYTES))"

clean:
	rm -f pxwrapm.o pxwrapm.elf pxwrapm.bin pxwrapm_cases.inc

.PHONY: all clean
