# build artifacts
/build/
obj_dir/
obj_dir_*/
*.o
*.so
*.a
*.d

# verilator / sim outputs
verif/tb/obj_dir/
verif/tb/obj_dir_sva/
verif/tb/obj_dir_selftest/
verif/soc/obj/
# standalone unit-gate Verilator build dirs (the run-*-gate.sh scripts normally build
# in $TMPDIR via mktemp, but guard against a local -Mdir; covers the L1 obj_l1*_chk and
# the L2 ven_l2 gate dirs alike).
verif/l1/obj_*/
*.vcd
*.fst

# traces
*.vtrace
verif/**/out/

# test binaries (built from sources tracked in-tree)
verif/tests/**/*.elf
verif/tests/**/*.bin
verif/tests/**/*.flat

# M2S system-mode bare-metal test build artifacts (sources .S/.ld/manifest +
# the *.golden reference trace stay tracked; .bin/.elf/.o are rebuilt by make)
verif/sys/tests/**/*.elf
verif/sys/tests/**/*.bin
verif/sys/tests/**/*.o
# M8.4 IDE: the disk image + RTL backing-store hex are regenerated from the
# committed single source of truth gen_disk.py (the gate's Stage 0), so they are
# build artifacts, not tracked references.
verif/sys/tests/**/*.img
verif/sys/tests/**/*.disk.hex

# sphinx docs build output (sources under docs/sphinx/ are tracked)
docs/sphinx/_build/
/_site/

# fpga / Vivado synth-probe outputs (sources under fpga/{scripts,constraints}/ +
# the *.md docs are tracked; build/ holds 350+ MB of logs + .dcp checkpoints +
# per-run rpts that are regenerated by the probe tcl, so they are NOT tracked).
fpga/build/
*.dcp
# Vivado run scratch (root-dir logs/journals + the .Xil project temp dir +
# place/route artifact droppings: clockInfo.txt, cong/ congestion reports, etc.)
vivado*.log
vivado*.jou
*.backup.log
.Xil/
clockInfo.txt
/cong/
*.rpx

# python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# tooling / agent scratch
.claude/

# editor
*.swp
.DS_Store
verif/tb/ps_periph_table.inc

# coverage-suite build artifacts
verif/cov/cosim/*/*.bin
verif/cov/cosim/*/*.elf
verif/cov/cosim/*/*.o
verif/cov/build_cov.log

# opgen generated per-opcode tests (regenerate via verif/cov/opgen/gen_*.py)
verif/cov/opgen/tests/
verif/cov/opgen/modes/
verif/cov/opgen/repros/
tmp/

# ao486-sim run/scratch dirs — 2GB Win95 disk images, state snapshots, logs, captures.
# The disk image is external (see ao486-sim/REPRODUCE.md); everything here is regenerated.
ao486-sim/run_*/
ao486-sim/*.log
ao486-sim/.build_ide.log
ao486-sim/**/*.bak
# host scratch (time_shim.so is rebuilt by setup.sh; framebuffer captures land here)
/tmp/
/run_probe/
/run_vfpu/

# logs and editor/script backups are scratch anywhere in the tree
*.log
*.bak

# ao486-sim boot/co-sim snapshots — multi-GB simulation state, regenerated on demand
ao486-sim/snaps/
ao486-sim/snaps_cb/

# Per-invocation Verilator/Vivado runs.  Their sources, constraints, scripts,
# compact reports, and Markdown evidence live elsewhere in the tree; these are
# reproducible products (object trees, DCPs, bitstreams, disk copies, caches,
# and logs) and must never be mistaken for source revisions.
/ao486-sim/obj_dir*
/rtl/obj_dir
/verif/tb/obj_dir*
/fpga/build*
/fpga/.Xil
/fpga/**/__pycache__
/fpga/*.bit.bin
/fpga_run_*
/fpga_debug_snapshot_synth*/
/verify_run_*
/obj_dir_*
/build
/tmp
/run_probe
/run_vfpu
/.Xil
/.pytest_cache

# FPGA verification evidence retains its README/Markdown reports and small
# reproducer scripts.  The disk/media copies and generated simulator work
# trees beneath it are disposable and often multi-gigabyte.
/fpga_verify_*/**/*.vhd
/fpga_verify_*/**/*.img
/fpga_verify_*/**/*.elf
/fpga_verify_*/**/*.bin
/fpga_verify_*/**/*.flat
/fpga_verify_*/**/*.result
/fpga_verify_*/**/*.EXE
/fpga_verify_*/**/*.COM
/fpga_verify_*/**/*.rom
/fpga_verify_*/**/*.gz
/fpga_verify_*/**/*.gold
/fpga_verify_*/**/*.goldlog
/fpga_verify_*/**/*.flatlog
/fpga_verify_*/**/*.rtl_A
/fpga_verify_*/**/*.rtl_B
/fpga_verify_*/**/*.cmp_A
/fpga_verify_*/**/*.cmp_B
/fpga_verify_*/**/*.LOG
/fpga_verify_*/**/ccache
/fpga_verify_*/**/obj_dir*
/fpga_verify_*/**/obj_*
/fpga_verify_*/**/work
/fpga_verify_*/**/work2
/fpga_verify_*/**/*_work
/fpga_verify_*/**/*_cmp.txt
/fpga_verify_*/**/*_metrics.txt
/fpga_verify_20260820/hwcompact
/fpga_verify_20260820/fppipe2_ab
/fpga_verify_20260822/quake_bios_workaround/patch_boot0_cr0

# The fragment-abort gate builds its tiny guest locally from the tracked
# assembly/linker sources.
/verif/fxabort/fxprog.bin
/verif/fxabort/fxprog.elf

# Historical progress/review notes are local working material, not source of
# truth.  Keep copies on each engineer's machine without publishing them.
/PROGRESS*.md
/REVIEW*.md
/docs_old/PROGRESS*.md
/docs_old/REVIEW*.md
